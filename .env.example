# ====================================================
# CAMBISTA ONLINE MONOREPO - ENVIRONMENT VARIABLES SAMPLE
# ====================================================

# MongoDB Atlas NoSQL (Primary database)
SPRING_DATA_MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/sample_mflix?retryWrites=true&w=majority

# Backend Database (PostgreSQL optional fallback)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cambista_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# Backend Security
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=3600000

# Messaging (Kafka & RabbitMQ)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=cambista
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
