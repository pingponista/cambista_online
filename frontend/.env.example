# Configuración de Entorno Frontend - Cambista Online
VITE_API_URL=/api/v1

# ─── Credenciales Públicas de OAuth (Client IDs) ──────────────────────────
# Google OAuth 2.0 (Google Cloud Console)
VITE_OAUTH_GOOGLE_CLIENT_ID=

# GitHub OAuth App (GitHub Settings -> Developer settings -> OAuth Apps)
VITE_OAUTH_GITHUB_CLIENT_ID=

# Facebook Login (Meta for Developers -> App ID)
VITE_OAUTH_FACEBOOK_APP_ID=
